# CAUTION! These are development configuration values only intended 
# for developer easy of deployment. Please run ./initialization script or 
# update credentials and configurations for deployment
V2XHUB_VERSION="develop"
INFRASTRUCTURE_ID="rsu_1234"
INFRASTRUCTURE_NAME="Test Intersection"

SIMULATION_MODE=FALSE
COMPOSE_PROFILES=""
SENSOR_JSON_FILE_PATH=""
MYSQL_PASSWORD="ChangeMe123!"
V2XHUB_USERNAME="v2xadmin"
V2XHUB_PASSWORD="ChangeMe123!"
V2XHUB_VOLUME_PATH="/tmp/v2xhub_data"

# --- TENA plugin LAN addressing (tena_lan ipvlan network) -----------------------
# The v2xhub container gets its own address on the physical LAN so TenaV2Xplugin
# advertises a routable endpoint to the Execution Manager rather than a
# docker-internal 172.x address (which the EM cannot call back to).

# Physical interface to attach the container's LAN address to.
# use ifconfig to find the interface name for the LAN you want to use, e.g., "wlp0s20f3"
LAN_PARENT_IF=""

LAN_SUBNET="192.168.55.0/24"
LAN_GATEWAY="192.168.55.1"   # CONFIRM with `ip route` on the deployment network

# Static LAN address for the v2xhub container.
# Ensure that the chosen ip does not collide with other devices on the LAN.
# Change the last octet to a unique value for your deployment.
TENA_LAN_IP="192.168.55.x"
