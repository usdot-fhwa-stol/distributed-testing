# Single source of truth for every pinned/tagged dependency the v2xhub + TENA plugin build uses.
# Each name matches an HCL `variable` in docker-bake.hcl -- source this before invoking bake so
# these values (not the fallback defaults there) are what actually gets built:
#   set -a && source versions.env && set +a && docker buildx bake --ssh default dt-v2xhub
#
# Neither V2X-Hub nor the plugin is vendored on disk (no git submodules) -- BuildKit's own
# git-context fetcher checks out these exact commits fresh as part of the build itself.

# github.com/usdot-fhwa-OPS/V2X-Hub -- branch ${V2XHUB_REF}, as of this pin
V2XHUB_REF=develop

# github.com/usdot-fhwa-stol/vug-v2xhub-v2x-plugin -- branch ${PLUGIN_REF},
# includes the PROJECT()/find_package(stol-1609dot2-2022 REQUIRED) fix needed for TenaV2XPlugin to
# build as a native v2i-hub plugin
PLUGIN_REF=develop

# J2735 spec version V2X-Hub and the plugin are both built against
J2735_VERSION=2024

# harbor.distributedtesting.org/distributed-testing/dt-build-general -- provides TENA middleware/OMs + boost
DT_BUILD_GENERAL_TAG=latest

# TENA's version directory name under dt-build-general's own TENA install (ls /home/dt_user/TENA) --
# TENA's cmake config needs this as a real env var (not just discoverable on disk) so it's still set
# when V2X-Hub's own later build stage runs cmake. Must be bumped alongside DT_BUILD_GENERAL_TAG
# whenever that image's bundled TENA version changes.
TENA_VERSION=6.0.11
