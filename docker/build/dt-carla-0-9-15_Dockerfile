# BUILD COMMAND: VERSION=0.0.1 && sudo DOCKER_BUILDKIT=1 docker build --build-arg version=$VERSION -t harbor.distributedtesting.org/dot-ostr-dt/dt-carla:0-9-15-$VERSION . --progress=plain -f dt-carla-0-9-15_Dockerfile
