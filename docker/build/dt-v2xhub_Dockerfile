#
# BUILD_COMMAND -> VERSION=0.0.3-hass && source build-assets_hass.env && sudo DOCKER_BUILDKIT=1 docker build --secret id=usdotfhwastol_token,src=usdotfhwastol_token --build-arg VERSION=$VERSION --build-context assets="$BUILD_DIR" -t harbor.distributedtesting.org/distributed-testing/dt-v2xhub:$VERSION . --progress=plain -f dt-v2xhub_Dockerfile

# dt-build-v2xhub image is a commit of the .devcontainer V2XHub image with all build artifacts. It was built locally using develop and then committed and tagged using 'docker commit ....'
# To update dt-build-v2xhub, you'll need to clone V2XHub and build/launch the devcontainer and all plugins - then commit that image again.

# Secret instructions:
# Github -> Settings -> developer settings -> create token(classic) -> give it all repo permissions, 90+ days expiration
# Make a file named `usdotfhwastol_token` under distributed-testing/docker/
# Copy your token into that file

FROM harbor.distributedtesting.org/distributed-testing/dt-build-v2xhub:latest AS build

SHELL ["/bin/bash", "-ec"]

WORKDIR /home/plugin

USER root

RUN apt-get update && \
    apt-get install -y python3-pip \
    # add some build packages
    zstd 

ARG TENA_VERSION="TENA-MiddlewareSDK-v6.0.9.A"
# INSTALL TENA deb
RUN --mount=type=bind,from=assets,source=.,target=/mnt/build,readonly \
    set -euo pipefail; \
    dpkg -x --force-overwrite /mnt/build/${TENA_VERSION}@Product@u2204-gcc11-64-*.deb . && \
    ar -x /mnt/build/${TENA_VERSION}@Product@u2204-gcc11-64-*.deb && \
    tar xf control.tar.* && \
    # move the postinst script into TENA dir to make it easier to copy and run later on final container
    mv ./postinst ./opt/TENA/postinst-MW 

ARG DIST_VERSION="DOT_OSTR-Combined-Distribution-v1.2.3"
# Install DT OMs
RUN --mount=type=bind,from=assets,source=.,target=/mnt/build,readonly \
    set -euo pipefail; \
    dpkg -x --force-overwrite /mnt/build/${DIST_VERSION}@Product@u2204-gcc11-64-*.deb . && \
    ar -x /mnt/build/${DIST_VERSION}@Product@u2204-gcc11-64-*.deb && \
    tar xf control.tar.* && \
    # move the postinst script into TENA dir to make it easier to copy and run later on final container
    mv ./postinst ./opt/TENA/postinst-DIST

FROM harbor.distributedtesting.org/distributed-testing/dt-build-v2xhub:latest

WORKDIR /home/plugin

USER root

# Mounts files in a temporary space with rw perms, copies them to container, runs postinst scripts, changes ownership
COPY --from=build --chown=plugin:nogroup /home/plugin/opt/TENA /home/plugin/TENA
RUN DSTROOT=/home/plugin ./TENA/postinst-MW
RUN DSTROOT=/home/plugin ./TENA/postinst-DIST
RUN mkdir /home/plugin/TENA/log
RUN chown -R plugin:nogroup /home/plugin/TENA

RUN apt-get update && apt-get install -y \
    cmake cmake-data git build-essential libboost-all-dev clang g++ lld ninja-build \
    libvulkan1 libpng-dev libtiff5-dev libjpeg-dev tzdata sed curl openssl unzip autoconf libtool rsync libxml2-dev

RUN --mount=type=secret,id=usdotfhwastol_token \
    USDOTFHWASTOL_TOKEN=$(cat /run/secrets/usdotfhwastol_token) && \
    git clone https://${USDOTFHWASTOL_TOKEN}@github.com/usdot-fhwa-stol/vug-cmake-package.git cmake_temp && \
    mv cmake_temp/cmake/ /home/plugin/TENA/lib/ && \
	rm -rf cmake_temp  

USER plugin

ARG VERSION=dev
LABEL version=${VERSION}
LABEL description="V2XHub Distributed Testing Docker Image"

# Once you have the built TENA V2X Plugin, uncomment the line below to copy it directly into the Docker image
# COPY lib/TenaV2Xplugin.zip /usr/local/plugins/TenaV2Xplugin.zip

RUN echo 'source /home/plugin/TENA/6.0.9/scripts/tenaenv-u2204-gcc11-64-v6.0.9.sh' >> /home/plugin/.bashrc

WORKDIR /var/log/tmx 

ENTRYPOINT ["/usr/local/bin/service.sh"]
