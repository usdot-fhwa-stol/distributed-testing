#
# BUILD COMMAND: VERSION=hass-latest && sudo DOCKER_BUILDKIT=1 docker build --build-arg VERSION=$VERSION -t harbor.distributedtesting.org/dot-ostr-dt/dt-v2xhub:$VERSION . --progress=plain -f dt-v2xhub_Dockerfile
#
# dt-v2xhub is the official usdotfhwaops/v2xhub runtime image (built from V2X-Hub's own Dockerfile) with
# TENA middleware/OMs, boost, and build tooling layered on top so a TENA V2X plugin can be compiled and
# linked against V2X-Hub's tmxutils/tmxapi (see /usr/local/share/tmx/tmx-plugin-config.cmake). TENA/boost
# are pulled in already-installed from dt-build-general instead of being reinstalled here, so no build
# secret is needed for this image.
#
# usdotfhwaops/v2xhub:develop-amd64 is a stripped runtime image: it ships tmxutils/tmxapi as prebuilt
# .a/.so files but never installs the SDK headers (PluginClient.h, tmx/j2735_messages/*.hpp, ...) --
# those only exist in V2X-Hub's own discarded intermediate build stage. Mixing headers from one V2X-Hub
# build with libs from another risks real ABI-breaking API drift, so the v2xhub-sdk-build stage below
# clones V2X-Hub and builds just its tmx/ SDK (skipping the v2i-hub plugins entirely -- those already
# come prebuilt from the runtime image below), and the final image takes /usr/local/include plus the tmx
# libs/cmake config from THAT build so headers and libs are always self-consistent.
#
# To update the base V2X-Hub image, pull a newer usdotfhwaops/v2xhub:develop-amd64 and bump
# V2XHUB_GIT_REF to the matching branch/commit.

# ----------------------- V2X-Hub SDK build stage ----------------------- #
FROM ubuntu:jammy AS v2xhub-sdk-build

ARG J2735_VERSION=2024
ARG V2XHUB_GIT_REF=develop
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch "$V2XHUB_GIT_REF" https://github.com/usdot-fhwa-OPS/V2X-Hub.git /home/V2X-Hub

RUN /home/V2X-Hub/scripts/install_dependencies.sh

WORKDIR /home/V2X-Hub/ext/
RUN ./build.sh

WORKDIR /home/V2X-Hub/src/

# Only the tmx/ SDK (headers + tmxcore/tmxutils/tmxapi/tmxctl) is needed to build a plugin against --
# drop v2i-hub so its plugins never get built here; they're pulled prebuilt from the runtime image.
RUN sed -i '/add_subdirectory(v2i-hub)/d' CMakeLists.txt

RUN /home/V2X-Hub/container/database.sh
RUN /home/V2X-Hub/container/library.sh
RUN ldconfig
RUN ./build.sh release --j2735-version "$J2735_VERSION"
RUN ldconfig

# ----------------------- dt-v2xhub ----------------------- #
FROM usdotfhwaops/v2xhub:develop-amd64

WORKDIR /home/plugin

USER root

# SDK headers + the exact libs/cmake config they were built against, from the self-consistent build above
COPY --from=v2xhub-sdk-build --chown=plugin:adm /usr/local/include /usr/local/include
COPY --from=v2xhub-sdk-build --chown=plugin:adm --chmod=544 /usr/local/lib/libtmxapi.* /usr/local/lib/
COPY --from=v2xhub-sdk-build --chown=plugin:adm --chmod=544 /usr/local/lib/libtmxctlStatic.a /usr/local/lib/
COPY --from=v2xhub-sdk-build --chown=plugin:adm --chmod=544 /usr/local/lib/libtmxutils.a /usr/local/lib/
COPY --from=v2xhub-sdk-build --chown=plugin:adm --chmod=544 /usr/local/share/tmx/*.cmake /usr/local/share/tmx/

# TENA middleware + DT OMs (already installed via postinst) and the boost build TENA links against
COPY --from=harbor.distributedtesting.org/dot-ostr-dt/dt-build-general:0.1.1 --chown=plugin:nogroup /home/dt_user/TENA /home/plugin/TENA
COPY --from=harbor.distributedtesting.org/dot-ostr-dt/dt-build-general:0.1.1 /opt/boost /opt/boost

# postinst baked dt-build-general's /home/dt_user path into TENA's env/config scripts; repoint them at
# this image's home so TENA_HOME/PATH/LD_LIBRARY_PATH resolve correctly when scripts are sourced here
RUN grep -rlZ '/home/dt_user' /home/plugin/TENA | xargs -0r sed -i 's#/home/dt_user#/home/plugin#g'

ENV BOOST_ROOT=/opt/boost \
    CMAKE_PREFIX_PATH=/opt/boost:${CMAKE_PREFIX_PATH:-} \
    LD_LIBRARY_PATH=/opt/boost/lib:${LD_LIBRARY_PATH:-}

RUN echo "/opt/boost/lib" > /etc/ld.so.conf.d/boost.conf && ldconfig

# Build tooling needed to compile a TENA plugin against V2X-Hub; not present in the runtime v2xhub image
RUN apt-get update && apt-get install -y \
    cmake cmake-data git build-essential clang g++ lld ninja-build python3-pip \
    libvulkan1 libpng-dev libtiff5-dev libjpeg-dev tzdata sed curl openssl unzip autoconf libtool rsync libxml2-dev

USER plugin

ARG VERSION=dev
LABEL version=${VERSION}
LABEL description="V2XHub Distributed Testing Docker Image"

# Once you have the built TENA V2X Plugin, uncomment the line below to copy it directly into the Docker image
# COPY lib/TenaV2Xplugin.zip /usr/local/plugins/TenaV2Xplugin.zip

RUN TENAENV=$(find /home/plugin/TENA -maxdepth 3 -iname 'tenaenv-u2204-gcc11-64-v*.sh' ! -name '*.template') && \
    echo "source $TENAENV" >> /home/plugin/.bashrc

WORKDIR /var/log/tmx

ENTRYPOINT ["/usr/local/bin/service.sh"]
