#
# BUILD COMMAND: VERSION=0.0.1 && source build-assets_simdis.env && sudo DOCKER_BUILDKIT=1 docker build --build-arg VERSION=$VERSION --build-context assets="$BUILD_DIR" -t harbor.distributedtesting.org/distributed-testing/dt-simdis:$VERSION . --progress=plain -f dt-simdis_Dockerfile
#

# ----------------------- BUILD STAGE ----------------------- #
FROM ubuntu:22.04 AS build

SHELL ["/bin/bash", "-ec"]

RUN useradd -ms /bin/bash dt_user
WORKDIR /home/dt_user

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    zstd curl binutils

USER root
WORKDIR /home/dt_user

ARG TENA_VERSION="TENA-MiddlewareSDK-v6.0.11"
# INSTALL TENA deb
RUN --mount=type=bind,from=assets,source=.,target=/mnt/build,readonly \
    set -euo pipefail; \
    dpkg -x --force-overwrite /mnt/build/${TENA_VERSION}@Product@u2204-gcc11-64-*.deb . && \
    ar -x /mnt/build/${TENA_VERSION}@Product@u2204-gcc11-64-*.deb && \
    tar xf control.tar.* && \
    # move the postinst script into TENA dir to make it easier to copy and run later on final container
    mv ./postinst ./opt/TENA/postinst-MW

ARG SDTP_VERSION="SIMDIS-TENApluginRuntime-v2.5.20"
# Install SIMDIS TENA Plugin
RUN --mount=type=bind,from=assets,source=.,target=/mnt/build,readonly \
    set -eu; \
    dpkg -x --force-overwrite /mnt/build/${SDTP_VERSION}@Product@u2204-gcc11-64-*.deb . && \
    ar -x /mnt/build/${SDTP_VERSION}@Product@u2204-gcc11-64-*.deb && \
    tar xf control.tar.* && \
    # move the postinst script into TENA dir to make it easier to copy and run later on final container
    mv ./postinst ./opt/TENA/postinst-SDTP

# ----------------------- RUNTIME STAGE ----------------------- #
FROM ubuntu:22.04

RUN useradd -ms /bin/bash dt_user
USER dt_user
ARG USER="dt_user"

USER root
WORKDIR /home/dt_user

RUN apt-get update && apt-get install -y --no-install-recommends \
    libx11-6 libglx0 libopengl0 libgl1 libxrender1 libxi6 libxrandr2 \
    libxinerama1 libxcursor1 libxfixes3 libxcomposite1 libxdamage1 libxkbcommon0 \
    libxkbcommon-x11-0 libfontconfig1 libfreetype6 libegl1 libglib2.0-0 libdbus-1-3 \
    libglu1-mesa libpulse0 libxcb-cursor0 libxcb-icccm4 libxcb-keysyms1 libxcb-shape0 \
    x11-utils mesa-utils \
    sudo libgeos-dev python3 python3-requests python3-shapely \
    && rm -rf /var/lib/apt/lists/* \
    && echo "dt_user ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/dt_user \
    && chmod 0440 /etc/sudoers.d/dt_user

USER root

ARG SIMDIS_VERSION="NRL_SIMDIS_v10.0_STABLE_2026-06"
RUN --mount=type=bind,from=assets,source=.,target=/mnt/build,readonly \
    set -eu; \
    cp /mnt/build/${SIMDIS_VERSION}_linux64_abi-cxx11.tar.run /tmp/simdis_installer.run && \
    chmod +x /tmp/simdis_installer.run && \
    /tmp/simdis_installer.run --prefix /home/dt_user/SIMDIS --createDesktopIcons 0 --setPath 1 --installRemoveSettings 0 && \
    rm -f /tmp/simdis_installer.run && \
    chown -R dt_user:dt_user /home/dt_user/SIMDIS

# All done as one RUN command to save space in the final container.
# Mounts the full TENA install in a temporary space, runs postinst scripts (which populate the
# self-contained SIMDIS TENA Plugin under SIMDIS/plugins), then deletes the ~3.7GB TENA_HOME
# tree entirely. This image only runs SIMDIS - it doesn't need execution manager, Console,
# Canary, or a standalone TENA_HOME on disk. Per the SIMDIS TENA Plugin docs, "there is no
# pre-requisite for the TENA MW to be installed" once SIMDIS/plugins has its own copies.
RUN --mount=from=build,source=/home/dt_user,target=/mnt/dt_user,rw \
    cp -a /mnt/dt_user/opt/TENA /home/dt_user/TENA && \
    env USER=dt_user DSTROOT=/home/dt_user /home/dt_user/TENA/postinst-MW && \
    env USER=dt_user DSTROOT=/home/dt_user SIMDIS_DIR=/home/dt_user/SIMDIS /home/dt_user/TENA/postinst-SDTP && \
    rm -rf /home/dt_user/TENA

# postinst-SDTP (from the SIMDIS TENA Plugin deb) installs its default TENA config,
# including model.dis, to a path it builds as "$DSTROOT/~/.config/...". Bash only expands
# "~" when it is the leading character of a word, not when embedded after a "/", so with
# DSTROOT=/home/dt_user set above, the script actually creates a directory literally named
# "~" instead of writing into /home/dt_user/.config/... (the path the SIMDIS TENA Plugin
# reads by default at runtime). Net effect: the plugin's default model.dis is never found.
# Separately, model.dis itself has a vendor bug: 8 rows in the "Lifeform Kind, Land Domain"
# section (SISO kind=3, domain=1) are missing the trailing "extra" field, so their entity
# type keys have 6 dot-separated fields instead of the required 7 and never match a real
# 7-field entity type. One of the 8 is the civilian/pedestrian row (3.1.0.130.0.0 instead of
# 3.1.0.130.0.0.0), which is exactly the DIS EntityType vug-entity-generator publishes for
# SDSM-sourced pedestrians. Unmatched entities fall back to SIMDIS's generic per-domain
# default (Ground Model = m1a2_abrams, an actual tank), which is why pedestrians rendered as
# tanks. Third bug: even once matched by a corrected 7-field key, these 8 model names resolve
# to files under data/models/public/other/, which (unlike public/vehicles, public/aircraft,
# etc.) isn't in this deployment's model search path, so SIMDIS still logs "Failed to find
# icon model" for a bare name. Fourth bug: the whole file has Windows (CRLF) line endings on
# every single line -- including rows that otherwise "work" via a separate default-model
# setting -- so a naive line-oriented reader appending a trailing \r to whatever token is
# last on the line (i.e. the model name/path) would silently corrupt every model reference in
# this file, not just the 8 patched below. All four are fixed here: move the config out of the
# bogus "~" directory, strip CRLF -> LF from the whole file, patch the 8 malformed rows, then
# rewrite those same 8 rows to reference their model file by absolute path instead of by bare
# name, which SIMDIS's "Data File Location" resolution checks before any search path.
RUN set -eu; \
    src="/home/dt_user/~/.config/Naval Research Laboratory/home/TENA"; \
    dst="/home/dt_user/.config/Naval Research Laboratory/home/TENA"; \
    if [ -d "$src" ]; then \
      mkdir -p "$dst" && \
      cp -a "$src/." "$dst/" && \
      rm -rf "/home/dt_user/~"; \
    fi && \
    modelDir="/home/dt_user/SIMDIS/data/models/public/other" && \
    sed -i \
      -e "s/\r\$//" \
      -e "s#^3\.1\.0\.50\.0\.0 arabic_male_crouching_police#3.1.0.50.0.0.0 ${modelDir}/arabic_male_crouching_police.3db#" \
      -e "s#^3\.1\.0\.70\.0\.0 jimmy#3.1.0.70.0.0.0 ${modelDir}/jimmy.3db#" \
      -e "s#^3\.1\.0\.90\.0\.0 soldier1#3.1.0.90.0.0.0 ${modelDir}/soldier1.3db#" \
      -e "s#^3\.1\.0\.100\.0\.0 arabic_male_crouching_ak47#3.1.0.100.0.0.0 ${modelDir}/arabic_male_crouching_ak47.3db#" \
      -e "s#^3\.1\.0\.102\.0\.0 arabic_male_standing_30cal#3.1.0.102.0.0.0 ${modelDir}/arabic_male_standing_30cal.3db#" \
      -e "s#^3\.1\.0\.110\.0\.0 soldier_pk762mgun#3.1.0.110.0.0.0 ${modelDir}/soldier_pk762mgun.3db#" \
      -e "s#^3\.1\.0\.130\.0\.0 male_civilian_western_standing#3.1.0.130.0.0.0 ${modelDir}/male_civilian_western_standing.3db#" \
      -e "s#^3\.1\.0\.200\.0\.0 dog#3.1.0.200.0.0.0 ${modelDir}/dog.3db#" \
      "$dst/model.dis" && \
    chown -R dt_user:dt_user /home/dt_user/.config

# .config is hidden by default in the SIMDIS file-picker dialogs (it doesn't show
# dotfiles/dotdirs unless "show hidden" is toggled), which is why the DIS Model Map path
# above is hard to Browse to manually. This symlink exposes the same directory under a
# non-hidden name so it shows up in the picker without needing to touch hidden-file settings.
RUN ln -sfn ".config" "/home/dt_user/config" && chown -h dt_user:dt_user "/home/dt_user/config"

# Kept for future use, but NOT currently wired into CMD: tried pre-filling the Models tab's
# "DIS Model Map" field via "-TENA:configFile" pointing at this file's "ModelFile" key.
# Verified empirically (screenshot of a live run) that the field stays empty -- per
# "simdis10 --help", it's actually "-TENA:autoStart" that "process[es] the configuration
# file", not "-TENA:configFile" by itself. Adding autoStart would also immediately attempt
# to connect using whatever EM address happens to be in this file, which is wrong for any
# deployment that isn't this exact placeholder -- worse than an empty field. Left unused
# until there's a reliable way to pre-fill fields without forcing a connect attempt.
RUN printf '%s\n' \
    '# NOT currently auto-loaded (see dt-simdis_Dockerfile comment above this file'"'"'s creation).' \
    'ModelFile /home/dt_user/.config/Naval Research Laboratory/home/TENA/model.dis' \
    > /home/dt_user/dt-simdis-defaults.cfg && \
    chown dt_user:dt_user /home/dt_user/dt-simdis-defaults.cfg

USER dt_user

ARG VERSION=dev
LABEL version=${VERSION}
LABEL description="Distributed Testing Docker image running SIMDIS + the self-contained SIMDIS TENA Plugin"

SHELL ["/bin/bash", "-ec"]

ARG DEBIAN_FRONTEND="noninteractive"
ARG TZ="America/New_York"

# SIMDIS needs LD_LIBRARY_PATH set to find its TENA plugin's dependencies (otherwise the
# plugin fails to load entirely: "Could find but not load ... cannot open shared object
# file"). Per the SIMDIS TENA Plugin docs, this must point at the SIMDIS/plugins dir (the
# self-contained copy installed above) - there's no TENA_HOME in this image to point at
# instead, and pointing at both at once causes duplicate-library / LocalClassMethodsFactory
# registration failures at joinExecution() time.
ENV LD_LIBRARY_PATH=/home/dt_user/SIMDIS/plugins

# "-plugin" makes SIMDIS load and dock the TENA panel automatically on startup, instead of
# requiring it to be opened manually from the Plug-ins menu every session (verified via
# screenshot). The very first time a given container's $HOME is fresh, this makes SIMDIS
# show a one-time "New Plug-ins Found" dialog (Load All -> Save); that decision is then
# persisted in the container's writable layer and does not reappear on subsequent restarts
# of the same container (verified: restarted the same container and it skipped straight to
# the TENA panel). It reappears only if the container is fully removed and recreated fresh.
CMD ["/bin/bash","-l","-c","cd /home/dt_user/SIMDIS && ./startSIMDIS.sh -plugin /home/dt_user/SIMDIS/plugins/piTENAplugin_2.5.20_mw6.0.11_u2204-gcc11-64.so"]
