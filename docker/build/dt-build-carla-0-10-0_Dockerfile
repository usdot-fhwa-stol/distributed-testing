#
# BUILD COMMAND: VERSION=0.10.0-0.0.1 && sudo DOCKER_BUILDKIT=1 docker build \
#   --build-arg VERSION=$VERSION \
#   -t harbor.distributedtesting.org/distributed-testing/dt-build-carla:$VERSION \
#   . --progress=plain -f dt-build-carla-0-10-0_Dockerfile
#
# NOTE: This builds the CARLA 0.10.0 adapter toolchain image; it is not a CARLA simulator runtime image.

FROM harbor.distributedtesting.org/distributed-testing-dev/dt-build-general:0.3.0

ARG VERSION=dev
ARG DEBIAN_FRONTEND="noninteractive"
ARG TZ="America/New_York"

LABEL version=${VERSION}
LABEL description="Distributed Testing build image for CARLA 0.10.0 TENA adapters"

USER root

# CARLA 0.10.0 requires CMake 3.27.2 or newer and a C++20 compiler. Keep
# GCC 11 as the container default so LibCarla and the u2204-gcc11 TENA
# libraries use the same compiler and libstdc++ ABI.
RUN apt-get clean && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        autoconf \
        build-essential \
        clang \
        curl \
        gcc-11 \
        g++-11 \
        git \
        git-lfs \
        libjpeg-dev \
        libpng-dev \
        libtiff5-dev \
        libtool \
        libvulkan1 \
        libxml2-dev \
        ninja-build \
        openssl \
        python3-dev \
        python3-pip \
        rsync \
        sed \
        tzdata \
        unzip && \
    update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-11 180 && \
    update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-11 180 && \
    python3 -m pip install --no-cache-dir --upgrade \
        pip \
        cmake==3.27.9 \
        auditwheel \
        distro \
        setuptools \
        wheel && \
    rm -rf /var/lib/apt/lists/* /root/.cache

ENV CC=/usr/bin/gcc-11
ENV CXX=/usr/bin/g++-11
ENV CARLA_HOME=/home/dt_user/carla
ENV CARLA_BUILD_DIR=/home/dt_user/carla/Build

USER dt_user
WORKDIR /home/dt_user

RUN git clone --branch 0.10.0 --depth 1 \
        https://github.com/carla-simulator/carla.git "$CARLA_HOME"

# Populate CARLA's FetchContent cache while constructing the image. The
# adapter build reuses this directory and links CARLA's native carla-client
# CMake target instead of the removed 0.9.x libcarla-install layout.
RUN cmake \
        -S "$CARLA_HOME" \
        -B "$CARLA_BUILD_DIR" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_COMPILER="$CC" \
        -DCMAKE_CXX_COMPILER="$CXX" \
        -DGCC_COMPILER="$CC" \
        -DGXX_COMPILER="$CXX" \
        -DCARLA_BOOST_VERSION=1.82.0 \
        -DCARLA_BOOST_TAG=boost-1.82.0 \
        "-DBOOST_INCLUDE_LIBRARIES=asio;iterator;python;date_time;geometry;container;variant2;gil;filesystem;system;thread" \
        -DBUILD_CARLA_CLIENT=ON \
        -DBUILD_CARLA_SERVER=OFF \
        -DBUILD_CARLA_UNREAL=OFF \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_LIBCARLA_TESTS=OFF \
        -DBUILD_PYTHON_API=ON \
        -DENABLE_ROS2=OFF \
        -DENABLE_OSM2ODR=OFF \
        -DENABLE_RSS=OFF

RUN echo 'source /home/dt_user/TENA/6.0.11/scripts/tenaenv-u2204-gcc11-64-v6.0.11.sh' >> /home/dt_user/.bashrc
