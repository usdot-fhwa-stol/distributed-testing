#
# BUILD COMMAND: VERSION=0.0.1 && source build-assets.env && DOCKER_BUILDKIT=1 docker build --build-arg version=$VERSION --build-context assets="$BUILD_DIR" -t harbor.distributedtesting.org/distributed-testing/dt-core:$VERSION . --progress=plain -f dt-core_Dockerfile
#

# ===================== BUILD STAGE ===================== #
FROM harbor.distributedtesting.org/distributed-testing/dt-base:latest AS build

SHELL ["/bin/bash", "-ec"]
ARG DEBIAN_FRONTEND="noninteractive"
ARG TZ="America/New_York"

USER dt_user
ENV USER="dt_user"

WORKDIR /home/$USER

USER root

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        apt-utils \
        rsync \
        zstd \
        unzip \
        binutils && \
    rm -rf /var/lib/apt/lists/*

USER $USER

# Install TENA DataView
ARG DV_VERSION="v1.5.4"
WORKDIR /home/$USER/INSTALL/DV
RUN --mount=type=bind,from=assets,source=.,target=/mnt/build,readonly \
    set -euo pipefail && \
    dpkg -x --force-overwrite /mnt/build/TDCS-DataView-${DV_VERSION}@Product@u2204-gcc11-64*.deb . && \
    ar -x /mnt/build/TDCS-DataView-${DV_VERSION}@Product@u2204-gcc11-64*.deb && \
    tar xf control.tar.* && \
    mv ./postinst ./opt/TENA/postinst-DV

#Install TENA Data Collection System
ARG TDCS_VERSION="VUG-Combined-DataCollectionDistribution-v1.3.3"
WORKDIR /home/$USER/INSTALL/TDCS
RUN --mount=type=bind,from=assets,source=.,target=/mnt/build,readonly \
    set -euo pipefail && \
    dpkg -x --force-overwrite /mnt/build/${TDCS_VERSION}@Product@u2204-gcc11-64*.deb . && \
    ar -x /mnt/build/${TDCS_VERSION}@Product@u2204-gcc11-64*.deb && \
    tar xf control.tar.* && \
    mv ./postinst ./opt/TENA/postinst-TDCS

# Install TENA JSON Tools
ARG JSON_VERSION="VUG-Combined-JSONtoolsDistribution-v1.3.3"
WORKDIR /home/$USER/INSTALL/JSON
RUN --mount=type=bind,from=assets,source=.,target=/mnt/build,readonly \
    set -euo pipefail && \
    dpkg -x --force-overwrite /mnt/build/${JSON_VERSION}@Product@u2204-gcc11-64*.deb . && \
    ar -x /mnt/build/${JSON_VERSION}@Product@u2204-gcc11-64*.deb && \
    tar xf control.tar.* && \
    mv ./postinst ./opt/TENA/postinst-JSON

WORKDIR /home/$USER

USER root

RUN rsync -a \
        INSTALL/DV/opt/TENA/ \
        INSTALL/TDCS/opt/TENA/ \
        INSTALL/JSON/opt/TENA/ \
        TENA/ && \
    chown -R root:root TENA

RUN DSTROOT=/home/$USER bash /home/$USER/TENA/postinst-DV || true && \
    DSTROOT=/home/$USER bash /home/$USER/TENA/postinst-TDCS || true && \
    sed -i '/^chown -R root/d;/^chgrp -R root/d' /home/$USER/TENA/postinst-JSON && \
    DSTROOT=/home/$USER bash /home/$USER/TENA/postinst-JSON || true

RUN find /home/$USER/TENA -type d -exec chmod 755 {} + && \
    find /home/$USER/TENA -type f -exec chmod a+r {} + && \
    find /home/$USER/TENA -type f -name "*.sh" -exec chmod a+x {} + && \
    find /home/$USER/TENA -type f -perm /111 -exec chmod a+x {} + && \
    chown -R $USER:$USER /home/$USER/TENA

USER $USER

RUN --mount=type=bind,from=assets,source=.,target=/mnt/build,readonly \
    set -euo pipefail && \
    unzip -j /mnt/build/CARLA_0.10.0.zip \
        '*/carla-0.10.0-cp310-cp310-linux_x86_64.whl' \
        -d /home/$USER/carla_wheels && \
    chown -R $USER:$USER /home/$USER/carla_wheels


# ===================== RUNTIME STAGE ===================== #
FROM harbor.distributedtesting.org/distributed-testing/dt-base:latest

SHELL ["/bin/bash", "-ec"]

ARG VERSION=dev
ARG DEBIAN_FRONTEND="noninteractive"
ARG TZ="America/New_York"

LABEL version=${VERSION} \
      description="Docker image for interoperability test"

ENV USER="dt_user" \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    PATH="/home/dt_user/.local/bin:$PATH"

WORKDIR /home/dt_user

USER root

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        # qt packages
        libxcb-xinerama0 libfreetype6 libfontconfig1 libsm6 libxi6 libx11-xcb1 \
        libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 \
        libxcb-render-util0 libxcb-shape0 libxcb-sync1 libxcb-xfixes0 libxcb-xkb1 \
        libxkbcommon-x11-0 libjpeg8 libtiff5 libevdev-dev fontconfig \
        # debug tools
        iputils-ping nano tshark git tcpdump nethogs curl \
        # iproute2
        iproute2 \
        # dub init to enable gracefully stopping container processes
        dumb-init \
        # python
        python3-dev python3-pip \
        # sumo tools
        sumo sumo-tools sumo-doc \
        # locales and set to UTF-8 for JSON Streamer
        locales && \
    locale-gen en_US.UTF-8 && \
    update-locale LANG=en_US.UTF-8 && \
    rm -rf /var/lib/apt/lists/*

USER dt_user

RUN pip3 install --no-cache-dir --user --upgrade pip setuptools wheel && \
    pip3 install --no-cache-dir --user \
        requests \
        networkx \
        scapy \
        numpy \
        pandas \
        matplotlib \
        shapely \
        pygame-ce \
        pycrate \
        pynput \
        lxml \
        traci

# Install the CARLA API .whl
COPY --chown=dt_user:dt_user --from=build /home/dt_user/carla_wheels /tmp/carla_wheels
RUN pip3 install --no-cache-dir /tmp/carla_wheels/carla-*cp310*.whl && \
    rm -rf /tmp/carla_wheels

# Install J2735_202409 python package
RUN git clone https://github.com/usdot-fhwa-stol/j2735_202409.git && \
    cd j2735_202409 && \
    pip3 install dist/j2735_202409-0.1.0-py3-none-any.whl && \
    cd .. && \
    rm -rf j2735_202409

USER root

RUN rm -rf /home/$USER/TENA

COPY --chown=dt_user:dt_user --from=build /home/$USER/TENA /home/$USER/TENA
COPY --chown=dt_user:dt_user ./lib/COPY /home/$USER

# Make start scripts executable
RUN chmod +x /home/dt_user/start_scripts/*

USER dt_user

RUN echo 'source /home/dt_user/start_scripts/setup-docker.sh' >> /home/dt_user/.bashrc

CMD ["/usr/bin/dumb-init", "-v", "--", "/bin/bash", "-l", "-c", "/home/dt_user/start_scripts/startup-apps.sh"]
