#
# BUILD COMMAND: VERSION=0.0.1 && sudo DOCKER_BUILDKIT=1 docker build --build-arg version=$VERSION -t harbor.distributedtesting.org/distributed-testing/dt-carla:0-10-0-$VERSION . --progress=plain -f dt-carla-0-10-0_Dockerfile
#

FROM carlasim/carla:0.10.0

ARG VERSION
ARG DEBIAN_FRONTEND="noninteractive"

LABEL version=${VERSION} \
    description="Distributed Testing Docker image for CARLA including event maps"

SHELL ["/bin/bash", "-ec"]

USER root

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    iproute2 iputils-ping curl \
    libxcb-xinerama0 libfreetype6 libfontconfig1 libsm6 libxi6 libx11-xcb1 \
    libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 \
    libxcb-render-util0 libxcb-shape0 libxcb-sync1 libxcb-xfixes0 libxcb-xkb1 \
    libxkbcommon-x11-0 libjpeg8 libtiff5 \
    dumb-init locales \
    fontconfig \
    build-essential \
    libevdev-dev \
    python3.10 python3.10-dev python3-pip && \
    locale-gen en_US.UTF-8 && \
    update-locale LANG=en_US.UTF-8 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 100 && \
    rm -rf /var/lib/apt/lists/*

COPY --chown=carla:carla ./lib/COPY/start_scripts              /home/carla/start_scripts
COPY --chown=carla:carla ./lib/COPY/.dt_site_config_docker     /home/carla/.dt_site_config_docker
COPY --chown=carla:carla ./lib/COPY/.dt_scenario_config_docker /home/carla/.dt_scenario_config_docker

RUN chmod +x /home/carla/start_scripts/*

USER carla

RUN pip3 install --no-cache-dir --user --upgrade pip setuptools wheel

RUN pip3 install --no-cache-dir --user \
    requests \
    networkx \
    scapy \
    numpy \
    pandas \
    shapely \
    pygame-ce \
    pycrate \
    pynput \
    lxml \
    traci \
    /home/carla/PythonAPI/carla/dist/carla-0.10.0-cp310-cp310-linux_x86_64.whl

RUN echo 'source /home/carla/start_scripts/setup-carla-docker.sh' >> /home/carla/.bashrc

CMD ["/bin/bash", "-l", "-c", "/home/carla/start_scripts/startup-carla.sh"]
