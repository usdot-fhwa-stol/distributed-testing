# GPSD integration defaults.
# Site/scenario configuration may override these values before this file is sourced.

# gpsd: send emulator output to the local GPSD bridge.
# direct: retain the existing emulator destination address and port.
export HWIL_GNSS_OUTPUT_MODE="${HWIL_GNSS_OUTPUT_MODE:-gpsd}"

# Local TCP input for emulator data.
export GPSD_INPUT_PORT="${GPSD_INPUT_PORT:-51928}"

# GPSD client endpoint. Set the bind address to the host's SDN IP
# when enabling access from an OBU.
export GPSD_CLIENT_BIND_ADDRESS="${GPSD_CLIENT_BIND_ADDRESS:-127.0.0.1}"
export GPSD_CLIENT_PORT="${GPSD_CLIENT_PORT:-52947}"

# Start GPSD independently of automatic emulator startup.
# Set GPSD_ENABLED=false in site/scenario configuration to disable it.
export GPSD_ENABLED="${GPSD_ENABLED:-true}"
